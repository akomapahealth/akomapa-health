{
  "name": "akomapa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "module": "esnext",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/__tests__/*.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build --webpack",
    "lighthouse": "node scripts/lighthouse.mjs",
    "security:verify-rsc-patch": "node scripts/verify-rsc-patch.mjs",
    "security:verify-intake-client-bundle": "node scripts/verify-intake-client-bundle.mjs",
    "security:verify-source-maps": "node scripts/verify-public-source-maps.mjs",
    "security:verify-actions-policy": "node scripts/verify-github-actions-policy.mjs",
    "security:verify-deployment": "node scripts/verify-deployed-security.mjs",
    "security:validate-exceptions": "node scripts/validate-vulnerability-exceptions.mjs",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "intake:retention": "node scripts/intake-retention.mjs",
    "validate": "npm run security:verify-rsc-patch && npm run security:audit:prod && npm run security:validate-exceptions && npm run security:verify-actions-policy && npm run lint && npm run typecheck && npm run test && npm run build && npm run security:verify-intake-client-bundle && npm run security:verify-source-maps && npm run test:e2e",
    "postinstall": "node scripts/ensure-husky-hooks.mjs",
    "prepare": "node scripts/ensure-husky-hooks.mjs",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --max-warnings 0 --fix"
    ]
  },
  "dependencies": {
    "@fillout/react": "3.1.2",
    "@headlessui/react": "^2.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@mailerlite/mailerlite-nodejs": "^1.7.0",
    "@next/third-parties": "16.3.4",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/nextjs": "^10.71.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "imagekitio-react": "^4.3.0",
    "leaflet": "^1.9.4",
    "lottie-react": "^2.4.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-pdf": "^9.2.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.17.30",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "13.4.1",
    "lint-staged": "^15.4.3",
    "playwright": "^1.56.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.1.4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
