#!/usr/bin/env sh
# Blocks commit if staged files fail ESLint (with fixes applied) or TypeScript check fails.
# Bypass (emergency only): HUSKY=0 git commit ...
set -e

required_node_major="$(tr -dc "0-9" < .nvmrc)"
actual_node_major="$(node -p "process.versions.node.split('.')[0]")"
if [ "$actual_node_major" != "$required_node_major" ]; then
  echo "Expected Node $required_node_major from .nvmrc, found $(node --version)."
  exit 1
fi

echo ""
echo "=== pre-commit: lint-staged (ESLint) ==="
npx lint-staged

echo ""
echo "=== pre-commit: TypeScript (tsc --noEmit) ==="
npm run typecheck

echo ""
echo "OK pre-commit passed"
echo ""
