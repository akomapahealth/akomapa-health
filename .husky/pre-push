#!/usr/bin/env sh
# Blocks push if the security, unit, build, and browser checks fail.
# Bypass (emergency only): git push --no-verify  OR  HUSKY=0 git push
set -e

required_node_major="$(tr -dc "0-9" < .nvmrc)"
actual_node_major="$(node -p "process.versions.node.split('.')[0]")"
if [ "$actual_node_major" != "$required_node_major" ]; then
  echo "Expected Node $required_node_major from .nvmrc, found $(node --version)."
  exit 1
fi

echo ""
echo "=== pre-push: React Server Components security patch ==="
npm run security:verify-rsc-patch

echo ""
echo "=== pre-push: ESLint (full project) ==="
npm run lint

echo ""
echo "=== pre-push: TypeScript ==="
npm run typecheck

echo ""
echo "=== pre-push: unit tests ==="
npm test

echo ""
echo "=== pre-push: production build ==="
npm run build

echo ""
echo "=== pre-push: client bundle security ==="
npm run security:verify-intake-client-bundle
npm run security:verify-source-maps

echo ""
echo "=== pre-push: Playwright E2E ==="
npm run test:e2e

echo ""
echo "OK pre-push passed"
echo ""
